.github/workflows/main.yml
name: 24-Hour Automated Bug Hunter

on:
  schedule:
    - cron: '0 */2 * * *' # Yeh har 2 ghante baad automatic cloud par bina ruke chalega
  workflow_dispatch: # Taaki aap iPhone se jab chahein manual bhi run kar sakein

jobs:
  run-scanner:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Code Repository
        uses: actions/checkout@v3

      - name: Load Python Environment
        uses: actions/setup-python@v4
        with:
          python-version: '3.10'

      - name: Install Network Dependencies
        run: pip install requests

      - name: Execute Security Scan Core
        env:
          TG_TOKEN: ${{ secrets.TELEGRAM_TOKEN }}
          TG_CHAT: ${{ secrets.TELEGRAM_CHAT_ID }}
        run: python scanner.py

      - name: Auto Commit Results to Repository
        run: |
          git config --global user.name "GitHub Action Bug Hunter"
          git config --global user.email "actions@github.com"
          git add found_bugs.txt || true
          git commit -m "Auto-updated discovered endpoints [GCP Security Node]" || true
          git push || true
