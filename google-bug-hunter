            response = requests.get(f"http://{subdomain}:{port}", timeout=4, verify=False)
            if response.status_code in [200, 401, 403]:
                return True, f"Open Sensitive Node Infrastructure Port {port} (Status {response.status_code})"
        except Exception:
            pass
    return False, ""

